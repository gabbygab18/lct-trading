####################################################################
# LCT Trading — production .env template (Z.com cPanel)
#
# On the server: rename this file to  .env  (File Manager > Rename)
# and fill in APP_URL, the DB_* and the MAIL_* values below.
#
# scripts/make_deploy.py fills APP_KEY with a fresh key inside the
# deploy zip, so no `php artisan key:generate` is needed on the server.
####################################################################

APP_NAME="LCT Trading"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lcttrading.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (cPanel > MySQL Databases) --------------------------
# cPanel prefixes the DB name and user with the account name,
# e.g. abc123_lct / abc123_lct
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_lct
DB_USERNAME=cpaneluser_lct
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# --- Mail (cPanel > Email Accounts, then use that mailbox's SMTP) --
# Order requests go to the email in /admin > Settings; ORDER_MAIL_TO is
# only the fallback when that setting is blank. Send THROUGH a mailbox
# on the site's own domain, not Gmail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.lcttrading.com
MAIL_PORT=465
MAIL_USERNAME=notifications@lcttrading.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notifications@lcttrading.com"
MAIL_FROM_NAME="${APP_NAME}"

ORDER_MAIL_TO=lcttrading08@gmail.com

# Behind Cloudflare (orange-cloud proxy): trust its forwarded headers so
# links stay https and each visitor's IP reaches the order rate limiter.
TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"
